{
  "name": "watchguard-comparison-react",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"vite\" \"node server/index.js\"",
    "dev:frontend": "vite",
    "dev:backend": "node server/index.js",
    "build": "vite build",
    "build:ghpages": "npx cross-env VITE_BASE_PATH=/LEADERWG/ vite build",
    "preview": "vite preview",
    "seed": "node server/seed.js",
    "export-data": "node scripts/export-static-data.cjs",
    "start": "NODE_ENV=production node server/index.js",
    "deploy": "npm run export-data && npm run build:ghpages && npx gh-pages -d dist",
    "railway:build": "npm run seed && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@lottiefiles/dotlottie-react": "^0.18.9",
    "@phosphor-icons/react": "^2.1.7",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.1"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "gh-pages": "^6.3.0",
    "vite": "^5.4.10"
  }
}
